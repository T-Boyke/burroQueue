## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Mono Auto Generated Files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/
publish-installer/
artifacts/

# Visual Studio 2015/2017/2019/2022/2025 cache/options directory
.vs/
.vscode/*.azos*

# Visual Studio Code local history
.history/

# MSTest / xUnit test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# JetBrains Rider
.idea/
*.sln.iml

# Local GitHub Actions Self-Hosted Runner directory (if placed inside workspace)
.runner/
actions-runner/
_work/
_diag/

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

