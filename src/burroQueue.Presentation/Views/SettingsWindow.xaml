<ui:FluentWindow
  x:Class="burroQueue.Presentation.Views.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="burroQueue – Einstellungen"
  Icon="pack://application:,,,/burroQueue;component/Assets/logo.png"
  Width="500"
  Height="570"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Native Title Bar with Burro Icon -->
    <ui:TitleBar Title="Einstellungen" Grid.Row="0">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/burroQueue;component/Assets/logo.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,10,0">
        <!-- Target Audio Output Device Routing -->
        <TextBlock
          Text="Ziel-Ausgabegerät (z. B. Büro-Box, getrennt vom Swyx-Headset)"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ComboBox
          Margin="0,6,0,16"
          ItemsSource="{Binding AvailableAudioDevices}"
          SelectedValue="{Binding SelectedAudioDeviceId, Mode=TwoWay}"
          SelectedValuePath="Id"
          DisplayMemberPath="DisplayName" />

        <!-- VoIP Telephony Ducking -->
        <TextBlock
          Text="VoIP- &amp; Telefonie-Dienst (Auto-Ducking)"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ComboBox
          Margin="0,6,0,16"
          ItemsSource="{Binding AvailableTelephonyProviders}"
          SelectedValue="{Binding SelectedProviderId, Mode=TwoWay}"
          SelectedValuePath="ProviderId"
          DisplayMemberPath="DisplayName" />

        <!-- Collaborative Playlist -->
        <TextBlock
          Text="Gemeinsame YouTube-Playlist (Einladungslink mit &amp;jct=...)"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ui:TextBox
          Margin="0,6,0,6"
          PlaceholderText="https://www.youtube.com/playlist?list=...&amp;jct=..."
          Text="{Binding CollaborativePlaylistUrl, UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox
          Margin="0,4,0,12"
          Content="Gemeinsame Playlist beim Gruppenbeitritt automatisch im Browser öffnen"
          IsChecked="{Binding AutoOpenCollaborativePlaylistOnJoin}" />

        <CheckBox
          Margin="0,0,0,16"
          Content="burroQueue beim Windows-Start automatisch im Hintergrund ausführen"
          IsChecked="{Binding IsAutostartEnabled}" />

        <!-- Display Name -->
        <TextBlock
          Text="Dein Anzeigename in der Gruppe"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ui:TextBox
          Margin="0,6,0,16"
          Text="{Binding ClientDisplayName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock
          Foreground="{DynamicResource SystemFillColorSuccessBrush}"
          FontSize="12"
          FontWeight="Medium"
          Text="{Binding StatusMessage}" />
      </StackPanel>
    </ScrollViewer>

    <ui:Button
      Grid.Row="2"
      HorizontalAlignment="Right"
      Appearance="Primary"
      Icon="{ui:SymbolIcon Save24}"
      Content="Speichern"
      Command="{Binding SaveSettingsCommand}" />
  </Grid>
</ui:FluentWindow>
