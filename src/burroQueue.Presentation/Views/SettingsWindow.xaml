<ui:FluentWindow
  x:Class="burroQueue.Presentation.Views.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="burroQueue – Einstellungen"
  Icon="pack://application:,,,/burroQueue;component/Assets/logo.png"
  Width="500"
  Height="570"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Native Title Bar with Burro Icon -->
    <ui:TitleBar Title="Einstellungen" Grid.Row="0">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/burroQueue;component/Assets/logo.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,10,0">
        <!-- Target Audio Output Device Routing -->
        <TextBlock
          Text="Ziel-Ausgabegerät (z. B. Büro-Box, getrennt vom Swyx-Headset)"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ComboBox
          Margin="0,6,0,16"
          ItemsSource="{Binding AvailableAudioDevices}"
          SelectedValue="{Binding SelectedAudioDeviceId, Mode=TwoWay}"
          SelectedValuePath="Id"
          DisplayMemberPath="DisplayName" />

        <!-- VoIP Telephony Ducking -->
        <TextBlock
          Text="VoIP- &amp; Telefonie-Dienst (Auto-Ducking)"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ComboBox
          Margin="0,6,0,16"
          ItemsSource="{Binding AvailableTelephonyProviders}"
          SelectedValue="{Binding SelectedProviderId, Mode=TwoWay}"
          SelectedValuePath="ProviderId"
          DisplayMemberPath="DisplayName" />

        <!-- Collaborative Playlist -->
        <TextBlock
          Text="Gemeinsame YouTube-Playlist (Einladungslink mit &amp;jct=...)"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ui:TextBox
          Margin="0,6,0,6"
          PlaceholderText="https://www.youtube.com/playlist?list=...&amp;jct=..."
          Text="{Binding CollaborativePlaylistUrl, UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox
          Margin="0,4,0,12"
          Content="Gemeinsame Playlist beim Gruppenbeitritt automatisch im Browser öffnen"
          IsChecked="{Binding AutoOpenCollaborativePlaylistOnJoin}" />

        <CheckBox
          Margin="0,0,0,16"
          Content="burroQueue beim Windows-Start automatisch im Hintergrund ausführen"
          IsChecked="{Binding IsAutostartEnabled}" />

        <!-- Display Name -->
        <TextBlock
          Text="Dein Anzeigename in der Gruppe"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ui:TextBox
          Margin="0,6,0,16"
          Text="{Binding ClientDisplayName, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Diagnostics & System Status -->
        <Border
          Margin="0,0,0,16"
          Padding="12,10"
          CornerRadius="8"
          Background="{DynamicResource SubtleFillColorSecondaryBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1">
          <StackPanel>
            <TextBlock
              Text="System- &amp; Audio-Diagnose"
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Margin="0,0,0,6" />

            <Grid Margin="0,2,0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Text="Audio-Engine: "
                FontSize="11"
                Opacity="0.7" />
              <TextBlock
                Grid.Column="1"
                Text="{Binding AudioEngineStatus}"
                FontSize="11"
                FontWeight="Medium"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Grid>

            <Grid Margin="0,2,0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Text="WebDrop URL: "
                FontSize="11"
                Opacity="0.7" />
              <TextBlock
                Grid.Column="1"
                Text="{Binding WebDropEndpointInfo}"
                FontSize="11"
                FontWeight="Medium"
                Opacity="0.9" />
            </Grid>

            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Text="LAN-P2P: "
                FontSize="11"
                Opacity="0.7" />
              <TextBlock
                Grid.Column="1"
                Text="{Binding LanMulticastInfo}"
                FontSize="11"
                FontWeight="Medium"
                Opacity="0.9" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock
          Foreground="{DynamicResource SystemFillColorSuccessBrush}"
          FontSize="12"
          FontWeight="Medium"
          Text="{Binding StatusMessage}" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <ui:Button
        Margin="0,0,8,0"
        Appearance="Secondary"
        Icon="{ui:SymbolIcon Dismiss24}"
        Content="Schließen"
        Click="OnCloseClicked" />
      <ui:Button
        Appearance="Primary"
        Icon="{ui:SymbolIcon Save24}"
        Content="Speichern"
        Command="{Binding SaveSettingsCommand}" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
