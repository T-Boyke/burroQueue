<ui:FluentWindow
  x:Class="burroQueue.Presentation.Views.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="burroQueue – Einstellungen"
  Icon="pack://application:,,,/burroQueue;component/Assets/logo.png"
  Width="500"
  Height="570"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner"
  FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
  TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Native Title Bar with Burro Icon -->
    <ui:TitleBar Title="Einstellungen" Grid.Row="0">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/burroQueue;component/Assets/logo.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,10,0">
        <!-- Target Audio Output Device Routing -->
        <TextBlock
          Text="Ziel-Ausgabegerät (z. B. Büro-Box, getrennt vom Swyx-Headset)"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ComboBox
          Margin="0,6,0,16"
          ItemsSource="{Binding AvailableAudioDevices}"
          SelectedValue="{Binding SelectedAudioDeviceId, Mode=TwoWay}"
          SelectedValuePath="Id"
          DisplayMemberPath="DisplayName" />

        <!-- VoIP Telephony Ducking -->
        <TextBlock
          Text="VoIP- &amp; Telefonie-Dienst (Auto-Ducking)"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ComboBox
          Margin="0,6,0,8"
          ItemsSource="{Binding AvailableTelephonyProviders}"
          SelectedValue="{Binding SelectedProviderId, Mode=TwoWay}"
          SelectedValuePath="ProviderId"
          DisplayMemberPath="DisplayName" />

        <!-- STARFACE Setup Info -->
        <Border
          Margin="0,0,0,10"
          Padding="12,10"
          CornerRadius="8"
          Background="{DynamicResource SubtleFillColorSecondaryBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          Visibility="{Binding IsStarfaceSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock
              Text="STARFACE UCC Client ➔ URLs / Anruf-Aktionen:"
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock
              Margin="0,4,0,0"
              FontSize="11"
              TextWrapping="Wrap"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Trage folgende URLs in den STARFACE-Einstellungen unter 'URLs / Anruf-Aktionen' ein:" />
            <TextBlock
              Margin="0,6,0,0"
              FontFamily="Consolas"
              FontSize="11"
              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
              Text="• Klingeln: http://127.0.0.1:41235/starface?state=ringing&#x0a;• Verbunden: http://127.0.0.1:41235/starface?state=connected&#x0a;• Beendet: http://127.0.0.1:41235/starface?state=idle" />
          </StackPanel>
        </Border>

        <!-- Ducking Release Delay after Call Ends -->
        <Grid Margin="0,2,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock
              Text="Nachlaufzeit nach Anrufende (Sekunden)"
              FontSize="12"
              FontWeight="Medium"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock
              FontSize="11"
              Opacity="0.7"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Wartezeit nach Gesprächs-/Anrufversuch-Ende vor Lautstärke-Wiederherstellung" />
          </StackPanel>
          <ui:TextBox
            Grid.Column="1"
            Width="72"
            VerticalAlignment="Center"
            TextAlignment="Center"
            Text="{Binding DuckingReleaseDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Collaborative Playlist -->
        <TextBlock
          Text="Gemeinsame YouTube-Playlist (Einladungslink mit &amp;jct=...)"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ui:TextBox
          Margin="0,6,0,2"
          PlaceholderText="https://www.youtube.com/playlist?list=...&amp;jct=..."
          Text="{Binding CollaborativePlaylistUrl, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
          Margin="0,0,0,6"
          FontSize="11"
          FontWeight="Medium"
          Foreground="{DynamicResource SystemFillColorSuccessBrush}"
          Text="{Binding CollaborativeUrlValidationText}"
          Visibility="{Binding IsCollaborativeUrlValid, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <CheckBox
          Margin="0,4,0,6"
          Content="Gemeinsame Playlist beim Gruppenbeitritt automatisch im Browser öffnen"
          IsChecked="{Binding AutoOpenCollaborativePlaylistOnJoin}" />

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <CheckBox
            Grid.Column="0"
            VerticalAlignment="Center"
            Content="Warteschlange regelmäßig automatisch mit YouTube-Playlist abgleichen"
            IsChecked="{Binding AutoSyncCollaborativePlaylist}" />
          <TextBlock
            Grid.Column="1"
            Margin="8,0,6,0"
            VerticalAlignment="Center"
            FontSize="11"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="Intervall (s):" />
          <ui:TextBox
            Grid.Column="2"
            Width="64"
            VerticalAlignment="Center"
            TextAlignment="Center"
            Text="{Binding AutoSyncPlaylistIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <CheckBox
          Margin="0,0,0,8"
          Content="Mobilen Web-Drop-Server für Smartphone-Uploads aktivieren (Port 8080)"
          IsChecked="{Binding EnableWebDropServer}" />

        <CheckBox
          Margin="0,0,0,16"
          Content="burroQueue beim Windows-Start automatisch im Hintergrund ausführen"
          IsChecked="{Binding IsAutostartEnabled}" />

        <!-- LAN Group Discovery & Management -->
        <TextBlock
          Text="Büro-Gruppen im lokalen Netzwerk (LAN)"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <Border
          Margin="0,6,0,16"
          Padding="12,10"
          CornerRadius="8"
          Background="{DynamicResource SubtleFillColorSecondaryBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Aktuelle Gruppe: " FontSize="12" Opacity="0.7" />
                <TextBlock Text="{Binding CurrentGroupName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              </StackPanel>
              <ui:Button
                Grid.Column="1"
                Appearance="Secondary"
                Padding="8,4"
                Icon="{ui:SymbolIcon ArrowSync24}"
                Content="Netzwerk suchen"
                Command="{Binding ScanGroupsCommand}" />
            </Grid>

            <!-- Discovered Groups List -->
            <ListView
              ItemsSource="{Binding DiscoveredGroups}"
              Background="Transparent"
              BorderThickness="0"
              MaxHeight="120"
              ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding GroupName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                      <TextBlock Text="{Binding HostEndpoint, StringFormat='Host: {0}'}" FontSize="10" Opacity="0.75" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button
                      Grid.Column="1"
                      Appearance="Subtle"
                      Padding="8,3"
                      Content="Beitreten"
                      Command="{Binding DataContext.JoinGroupCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                      CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <Separator Margin="0,6" Opacity="0.3" />

            <!-- Create New Group -->
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox
                Grid.Column="0"
                Margin="0,0,6,0"
                PlaceholderText="Name für neue Jukebox-Gruppe..."
                Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
              <ui:Button
                Grid.Column="1"
                Appearance="Secondary"
                Padding="10,5"
                Content="Gruppe gründen"
                Command="{Binding CreateNewGroupCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Display Name -->
        <TextBlock
          Text="Dein Anzeigename in der Gruppe"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ui:TextBox
          Margin="0,6,0,16"
          Text="{Binding ClientDisplayName, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Appearance: Window Backdrop & System Accent Color -->
        <TextBlock
          Text="Darstellung &amp; Fenster-Hintergrund (Backdrop)"
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <Border
          Margin="0,6,0,16"
          Padding="12,10"
          CornerRadius="8"
          Background="{DynamicResource SubtleFillColorSecondaryBrush}"
          BorderBrush="{DynamicResource SystemAccentColorSecondaryBrush}"
          BorderThickness="1">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock
                  Text="Window Backdrop (Auto / Mica / Tabbed / Acrylic / None)"
                  FontSize="12"
                  FontWeight="Medium"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock
                  FontSize="11"
                  Opacity="0.7"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="Windows 11 Material-Effekt via SystemThemeWatcher" />
              </StackPanel>
              <ComboBox
                Grid.Column="1"
                Width="130"
                VerticalAlignment="Center"
                ItemsSource="{Binding AvailableWindowBackdrops}"
                SelectedItem="{Binding SelectedWindowBackdrop, Mode=TwoWay}" />
            </Grid>

            <CheckBox
              Margin="0,2,0,0"
              Content="Windows System-Akzentfarbe automatisch übernehmen (SystemAccentColor)"
              IsChecked="{Binding UseSystemAccentColor}" />
          </StackPanel>
        </Border>

        <!-- Diagnostics & System Status -->
        <Border
          Margin="0,0,0,16"
          Padding="12,10"
          CornerRadius="8"
          Background="{DynamicResource SubtleFillColorSecondaryBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1">
          <StackPanel>
            <TextBlock
              Text="System- &amp; Audio-Diagnose"
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Margin="0,0,0,6" />

            <Grid Margin="0,2,0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Text="Audio-Engine: "
                FontSize="11"
                Opacity="0.7" />
              <TextBlock
                Grid.Column="1"
                Text="{Binding AudioEngineStatus}"
                FontSize="11"
                FontWeight="Medium"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Grid>

            <Grid Margin="0,2,0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Text="WebDrop URL: "
                FontSize="11"
                Opacity="0.7" />
              <TextBlock
                Grid.Column="1"
                Text="{Binding WebDropEndpointInfo}"
                FontSize="11"
                FontWeight="Medium"
                Opacity="0.9" />
            </Grid>

            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Text="LAN-P2P: "
                FontSize="11"
                Opacity="0.7" />
              <TextBlock
                Grid.Column="1"
                Text="{Binding LanMulticastInfo}"
                FontSize="11"
                FontWeight="Medium"
                Opacity="0.9" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock
          Foreground="{DynamicResource SystemFillColorSuccessBrush}"
          FontSize="12"
          FontWeight="Medium"
          Text="{Binding StatusMessage}" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <ui:Button
        Margin="0,0,8,0"
        Appearance="Secondary"
        Icon="{ui:SymbolIcon Dismiss24}"
        Content="Schließen"
        Click="OnCloseClicked" />
      <ui:Button
        Appearance="Primary"
        Icon="{ui:SymbolIcon Save24}"
        Content="Speichern"
        Command="{Binding SaveSettingsCommand}" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
