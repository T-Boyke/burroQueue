<ui:FluentWindow
  x:Class="burroQueue.Presentation.Views.TrackToastWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="burroQueue – Jetzt läuft"
  Width="340"
  Height="88"
  WindowStyle="None"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  ShowActivated="False"
  Topmost="True"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
  <Border
    Padding="10"
    CornerRadius="8"
    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{DynamicResource SystemAccentColorSecondaryBrush}"
    BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Song Cover (gleiche Größe wie Now-Playing Card: 64x48) -->
      <Border
        Grid.Column="0"
        Width="64"
        Height="48"
        Margin="0,0,12,0"
        CornerRadius="4"
        ClipToBounds="True"
        VerticalAlignment="Center"
        BorderBrush="{DynamicResource SystemAccentColorTertiaryBrush}"
        BorderThickness="1"
        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
        <Image
          x:Name="CoverImage"
          Stretch="UniformToFill"
          RenderOptions.BitmapScalingMode="LowQuality" />
      </Border>

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock
          x:Name="HeaderText"
          FontSize="10"
          FontWeight="SemiBold"
          Opacity="0.7"
          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
          Text="burroQueue – Jetzt läuft" />
        <TextBlock
          x:Name="MessageText"
          Margin="0,2,0,0"
          FontSize="12"
          FontWeight="SemiBold"
          TextTrimming="CharacterEllipsis"
          TextWrapping="Wrap"
          MaxHeight="34"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      </StackPanel>
    </Grid>
  </Border>
</ui:FluentWindow>
