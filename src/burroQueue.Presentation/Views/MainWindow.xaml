<ui:FluentWindow
  x:Class="burroQueue.Presentation.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="burroQueue"
  Icon="pack://application:,,,/burroQueue;component/Assets/logo.png"
  Width="520"
  Height="680"
  AllowDrop="True"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  ShowInTaskbar="True"
  FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
  TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  DragOver="OnDragOver"
  Drop="OnDrop">
  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Native Title Bar flush with top/right window edge for full HTCAPTION drag area -->
    <ui:TitleBar Title="burroQueue" Grid.Row="0" Margin="0" Padding="12,0,0,0">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/burroQueue;component/Assets/logo.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1" Margin="18,6,18,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

    <!-- Group Header, Quick Settings & Collaborative Playlist -->
    <StackPanel Grid.Row="1" Margin="0,6,0,8">
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon
            Symbol="PeopleCommunity24"
            Margin="0,0,8,0"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
          <TextBlock
            FontSize="13"
            FontWeight="Normal"
            Opacity="0.75"
            Text="Gruppe: " />
          <TextBlock
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
            Text="{Binding GroupName}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button
            Appearance="Secondary"
            Padding="8,4"
            Margin="0,0,6,0"
            Icon="{ui:SymbolIcon Open24}"
            Content="Playlist öffnen"
            Visibility="{Binding CollaborativePlaylistUrl, Converter={StaticResource NullToVisibilityConverter}}"
            Command="{Binding OpenCollaborativePlaylistCommand}" />
          <ui:Button
            Appearance="Secondary"
            Padding="8,4"
            Icon="{ui:SymbolIcon Settings24}"
            Content="Einstellungen"
            Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
      </Grid>

      <!-- First-Join Collaborative YouTube Playlist Prompt Banner -->
      <Border
        Margin="0,4,0,0"
        Padding="10,8"
        CornerRadius="6"
        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        Visibility="{Binding IsFirstJoinPromptVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock
              FontWeight="SemiBold"
              FontSize="11"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="Gemeinsame YouTube-Playlist verfügbar!" />
            <TextBlock
              Margin="0,1,0,0"
              FontSize="10"
              Opacity="0.8"
              TextWrapping="Wrap"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Tritt der YouTube-Playlist bei, um Songs mit der Gruppe zu synchronisieren." />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
            <ui:Button
              Appearance="Primary"
              Padding="8,3"
              Margin="0,0,4,0"
              FontSize="11"
              Content="Auf YouTube beitreten"
              Command="{Binding OpenYouTubeInviteAndDismissPromptCommand}" />
            <ui:Button
              Appearance="Transparent"
              Padding="4,2"
              ToolTip="Ausblenden"
              Command="{Binding DismissFirstJoinPromptCommand}">
              <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
            </ui:Button>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Now Playing Card with Album Art & Skip Vote -->
    <Border
      Grid.Row="2"
      Margin="0,0,0,8"
      Padding="12"
      CornerRadius="8"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource SystemAccentColorSecondaryBrush}"
      BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border
            Grid.Column="0"
            Width="64"
            Height="48"
            Margin="0,0,12,0"
            CornerRadius="4"
            ClipToBounds="True"
            BorderBrush="{DynamicResource SystemAccentColorTertiaryBrush}"
            BorderThickness="1"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Image
              Source="{Binding CurrentTrackThumbnailUrl}"
              Stretch="UniformToFill" />
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              TextTrimming="CharacterEllipsis"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{Binding CurrentTrackTitle}" />
            <TextBlock
              Margin="0,2,0,0"
              FontSize="12"
              Opacity="0.85"
              TextTrimming="CharacterEllipsis"
              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
              Text="{Binding CurrentTrackArtist}" />
            <StackPanel
              Orientation="Horizontal"
              Margin="0,3,0,0"
              Visibility="{Binding CurrentTrackSubmittedBy, Converter={StaticResource NullToVisibilityConverter}}">
              <Ellipse
                Width="15"
                Height="15"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                StrokeThickness="1"
                Visibility="{Binding CurrentTrackSubmitterAvatarUrl, Converter={StaticResource NullToVisibilityConverter}}">
                <Ellipse.Fill>
                  <ImageBrush
                    ImageSource="{Binding CurrentTrackSubmitterAvatarUrl, Converter={StaticResource AvatarUriToImageSourceConverter}}"
                    Stretch="UniformToFill" />
                </Ellipse.Fill>
              </Ellipse>
              <TextBlock
                FontSize="11"
                Opacity="0.75"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding CurrentTrackSubmittedBy, StringFormat='von {0}'}" />
            </StackPanel>
          </StackPanel>

          <!-- Vote to Skip Action -->
          <ui:Button
            Grid.Column="2"
            Appearance="Transparent"
            VerticalAlignment="Center"
            Padding="8,6"
            Icon="{ui:SymbolIcon Vote24}"
            Command="{Binding VoteToSkipCommand}">
            <TextBlock
              FontSize="12"
              FontWeight="Medium"
              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
              Text="{Binding SkipVoteStatus, StringFormat='Skip ({0})'}" />
          </ui:Button>
        </Grid>

        <!-- Visual Playback Progress Indicator (Non-interactive) -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ProgressBar
            Grid.Row="0"
            Height="4"
            Minimum="0"
            Maximum="100"
            Value="{Binding PlaybackProgress}"
            IsIndeterminate="False"
            Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"
            Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
          <TextBlock
            Grid.Row="1"
            Margin="0,4,0,0"
            FontSize="10"
            Opacity="0.75"
            HorizontalAlignment="Right"
            Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
            Text="{Binding PlaybackTimeFormatted}" />
        </Grid>
      </Grid>
    </Border>

    <!-- Playback Navigation Bar -->
    <Grid Grid.Row="3" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal">
        <ui:Button
          Margin="0,0,6,0"
          Appearance="Primary"
          Command="{Binding TogglePlayPauseCommand}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Margin="0,0,6,0" FontSize="15">
              <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                  <Setter Property="Symbol" Value="Play24" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                      <Setter Property="Symbol" Value="Pause24" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <TextBlock VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="Play" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                      <Setter Property="Text" Value="Pause" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </ui:Button>
        <ui:Button
          Margin="0,0,6,0"
          Appearance="Secondary"
          Icon="{ui:SymbolIcon Stop24}"
          Content="Stop"
          Command="{Binding StopCommand}" />
        <ui:Button
          Margin="0,0,6,0"
          Appearance="Secondary"
          Icon="{ui:SymbolIcon Next24}"
          Content="Skip"
          Command="{Binding SkipCommand}" />
        <ui:Button
          Margin="0,0,6,0"
          Padding="9,6"
          ToolTip="Hardware-CSPRNG Shuffle ein-/ausschalten"
          Command="{Binding ToggleShuffleCommand}">
          <ui:Button.Style>
            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
              <Setter Property="Appearance" Value="Secondary" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                  <Setter Property="Appearance" Value="Primary" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Button.Style>
          <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="15" />
        </ui:Button>
        <ui:Button
          Margin="0,0,6,0"
          Padding="9,6"
          ToolTip="Playlist wiederholen ein-/ausschalten"
          Command="{Binding ToggleRepeatAllCommand}">
          <ui:Button.Style>
            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
              <Setter Property="Appearance" Value="Secondary" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsRepeatAllEnabled}" Value="True">
                  <Setter Property="Appearance" Value="Primary" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ui:Button.Style>
          <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="15" />
        </ui:Button>
      </StackPanel>

      <Border
        Grid.Column="1"
        VerticalAlignment="Center"
        Padding="8,3"
        CornerRadius="4"
        BorderBrush="{DynamicResource SystemAccentColorSecondaryBrush}"
        BorderThickness="1"
        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
        <TextBlock
          FontSize="11"
          FontWeight="SemiBold"
          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
          Text="{Binding PlaybackState, StringFormat='Status: {0}'}" />
      </Border>
    </Grid>

    <!-- Master Volume, Ducking Badge & Audio Routing Bar -->
    <Border
      Grid.Row="4"
      Margin="0,0,0,8"
      Padding="10,6"
      CornerRadius="8"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Mute / Speaker Toggle Button -->
        <ui:Button
          Grid.Column="0"
          Appearance="Transparent"
          Padding="4,2"
          Margin="0,0,8,0"
          ToolTip="Stummschalten / Lautstärke wiederherstellen"
          Command="{Binding ToggleMuteCommand}">
          <ui:SymbolIcon
            Symbol="Speaker224"
            FontSize="16"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </ui:Button>

        <!-- Master Volume Slider -->
        <Slider
          Grid.Column="1"
          VerticalAlignment="Center"
          Minimum="0.0"
          Maximum="1.0"
          SmallChange="0.05"
          LargeChange="0.1"
          Foreground="{DynamicResource SystemAccentColorSecondaryBrush}"
          Value="{Binding MasterVolume, Mode=TwoWay}" />

        <!-- Volume Percentage -->
        <TextBlock
          Grid.Column="2"
          Margin="8,0,10,0"
          VerticalAlignment="Center"
          FontSize="12"
          FontWeight="SemiBold"
          Width="40"
          TextAlignment="Right"
          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
          Text="{Binding MasterVolume, StringFormat='{}{0:P0}'}" />

        <!-- Audio Device & Ducking Status Pill -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Border
            Margin="0,0,6,0"
            Padding="6,2"
            CornerRadius="4"
            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
            Visibility="{Binding IsAudioDucked, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock
              FontSize="10"
              FontWeight="Bold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="Ducking aktiv" />
          </Border>

          <TextBlock
            FontSize="11"
            VerticalAlignment="Center"
            Opacity="0.7"
            ToolTip="Aktives Audio-Ausgabegerät (in Einstellungen anpassen)"
            Text="{Binding ActiveAudioDeviceName}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Middle Section: Drop Zone, Interactive Queue View & Group Favorites -->
    <Grid Grid.Row="5" Margin="0,0,0,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Primary Drop Zone & Quick Add Bar -->
      <Border
        Grid.Row="0"
        Margin="0,0,0,8"
        Padding="12,10"
        CornerRadius="8"
        Cursor="Hand"
        MouseLeftButtonUp="OnDropZoneMouseLeftButtonUp"
        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
        BorderBrush="{DynamicResource SystemAccentColorSecondaryBrush}"
        BorderThickness="1">
        <StackPanel>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:SymbolIcon
              Symbol="ArrowDownload24"
              FontSize="22"
              Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />
            <TextBlock
              Margin="0,3,0,0"
              HorizontalAlignment="Center"
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="YouTube-Link hier hineinziehen, klicken oder per Ctrl+V einfügen" />
            <TextBlock
              Margin="0,1,0,0"
              HorizontalAlignment="Center"
              FontSize="11"
              Opacity="0.65"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{Binding StatusMessage}" />
          </StackPanel>

          <!-- Visual Add Feedback Banner -->
          <Border
            Margin="0,8,0,0"
            Padding="8,5"
            CornerRadius="6"
            Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Visibility="{Binding IsAddFeedbackVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
              <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding LastAddedFeedbackText}" />
            </StackPanel>
          </Border>

          <!-- Quick-Add Input Bar with Click-to-Reveal, Enter & Escape support -->
          <Grid
            Margin="0,8,0,0"
            Visibility="{Binding IsQuickAddInputVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
              x:Name="QuickAddTextBox"
              Grid.Column="0"
              Margin="0,0,6,0"
              Padding="8,5"
              PlaceholderText="YouTube-Link oder Video-ID hier eintippen..."
              Text="{Binding QuickAddUrl, UpdateSourceTrigger=PropertyChanged}"
              LostFocus="OnQuickAddLostFocus"
              KeyDown="OnQuickAddKeyDown" />
            <ui:Button
              Grid.Column="1"
              Appearance="Primary"
              Padding="10,5"
              ToolTip="Titel zur Warteschlange hinzufügen"
              Command="{Binding SubmitQuickAddCommand}">
              <ui:SymbolIcon Symbol="Add24" FontSize="14" />
            </ui:Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Expandable Interactive Queue View -->
      <Border
        x:Name="QueueContainerBorder"
        Grid.Row="1"
        CornerRadius="8"
        Padding="8"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsQueueExpanded}" Value="False">
                <Setter Property="VerticalAlignment" Value="Top" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Queue Header with Toggle, Sync & Clear Action -->
          <Grid Grid.Row="0" Margin="4,2,4,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon
                Symbol="MusicNote224"
                Margin="0,0,6,0"
                FontSize="14"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding QueuedCount, StringFormat='Warteschlange ({0})'}" />
            </StackPanel>

            <ui:Button
              Grid.Column="1"
              Appearance="Transparent"
              Padding="6,2"
              Margin="0,0,4,0"
              ToolTip="Mit YouTube-Playlist synchronisieren"
              Visibility="{Binding CollaborativePlaylistUrl, Converter={StaticResource NullToVisibilityConverter}}"
              Command="{Binding SyncPlaylistNowCommand}">
              <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </ui:Button>

            <ui:Button
              Grid.Column="2"
              Appearance="Transparent"
              Padding="6,2"
              Margin="0,0,4,0"
              ToolTip="Warteschlange leeren"
              Command="{Binding ClearQueueCommand}">
              <ui:SymbolIcon Symbol="Delete24" FontSize="13" />
            </ui:Button>

            <ui:Button
              Grid.Column="3"
              Appearance="Transparent"
              Padding="6,2"
              Command="{Binding ToggleQueueExpandedCommand}">
              <ui:SymbolIcon>
                <ui:SymbolIcon.Style>
                  <Style TargetType="ui:SymbolIcon">
                    <Setter Property="Symbol" Value="ChevronUp24" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsQueueExpanded}" Value="False">
                        <Setter Property="Symbol" Value="ChevronDown24" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:SymbolIcon.Style>
              </ui:SymbolIcon>
            </ui:Button>
          </Grid>

          <!-- Queued Items List (Non-Destructive Cursor Queue with Active Highlight & History) -->
          <ListView
            Grid.Row="1"
            Visibility="{Binding IsQueueExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
            ItemsSource="{Binding QueueViewItems}"
            HorizontalContentAlignment="Stretch"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.CacheLength="1,1"
            VirtualizingPanel.CacheLengthUnit="Page"
            ScrollViewer.IsDeferredScrollingEnabled="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            Background="Transparent"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            BorderThickness="0"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="6" Padding="6,3">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="BorderBrush" Value="Transparent" />
                      <Setter Property="BorderThickness" Value="0" />
                      <Setter Property="Opacity" Value="1.0" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPlayed}" Value="True">
                          <Setter Property="Opacity" Value="0.65" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                          <Setter Property="Opacity" Value="1.0" />
                          <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorSecondaryBrush}" />
                          <Setter Property="BorderThickness" Value="3,1,1,1" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <DockPanel LastChildFill="True">
                    <!-- Rechts angedockte Aktions-Icons (exakt untereinander ausgerichtet) -->
                    <StackPanel
                      DockPanel.Dock="Right"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      Margin="8,0,0,0">
                      <ui:Button
                        Height="26"
                        Appearance="Transparent"
                        Padding="5,0"
                        Margin="0,0,3,0"
                        ToolTip="Song für Gruppen-Favoriten upvoten"
                        Command="{Binding DataContext.ToggleTrackUpvoteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding Track}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <ui:SymbolIcon Symbol="ThumbLike24" FontSize="12">
                            <ui:SymbolIcon.Style>
                              <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsUpvotedByLocalUser}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </ui:SymbolIcon.Style>
                          </ui:SymbolIcon>
                          <TextBlock
                            Margin="3,0,0,0"
                            FontSize="10"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Text="{Binding UpvoteCount}" />
                        </StackPanel>
                      </ui:Button>
                      <ui:Button
                        Width="26"
                        Height="26"
                        Appearance="Transparent"
                        Padding="0"
                        Margin="0,0,2,0"
                        ToolTip="Sofort abspielen"
                        Command="{Binding DataContext.PlayTrackNowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding Track}">
                        <ui:SymbolIcon
                          Symbol="Play24"
                          FontSize="12"
                          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                      </ui:Button>
                      <ui:Button
                        Width="26"
                        Height="26"
                        Appearance="Transparent"
                        Padding="0"
                        Margin="0,0,2,0"
                        ToolTip="Nach oben verschieben"
                        Command="{Binding DataContext.MoveTrackUpCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding Track}">
                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="12" />
                      </ui:Button>
                      <ui:Button
                        Width="26"
                        Height="26"
                        Appearance="Transparent"
                        Padding="0"
                        Margin="0,0,2,0"
                        ToolTip="Nach unten verschieben"
                        Command="{Binding DataContext.MoveTrackDownCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding Track}">
                        <ui:SymbolIcon Symbol="ArrowDown24" FontSize="12" />
                      </ui:Button>
                      <ui:Button
                        Width="26"
                        Height="26"
                        Appearance="Transparent"
                        Padding="0"
                        ToolTip="Aus Warteschlange entfernen"
                        Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding Track}">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="12" />
                      </ui:Button>
                    </StackPanel>

                    <!-- Links: Thumbnail + Titel/Submitter (füllt restliche Breite bis zu den rechts angedockten Icons) -->
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Border
                        Grid.Column="0"
                        Width="44"
                        Height="33"
                        CornerRadius="4"
                        Margin="0,0,10,0"
                        ClipToBounds="True"
                        BorderBrush="{DynamicResource SystemAccentColorTertiaryBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Image
                          Source="{Binding ThumbnailUrl}"
                          Stretch="UniformToFill"
                          RenderOptions.BitmapScalingMode="LowQuality" />
                      </Border>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                          FontSize="12"
                          TextTrimming="CharacterEllipsis"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Text="{Binding Title}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="FontWeight" Value="Medium" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                                  <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                          <Ellipse
                            Width="14"
                            Height="14"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                            StrokeThickness="1"
                            Visibility="{Binding SubmitterAvatarUrl, Converter={StaticResource NullToVisibilityConverter}}">
                            <Ellipse.Fill>
                              <ImageBrush
                                ImageSource="{Binding SubmitterAvatarUrl, Converter={StaticResource AvatarUriToImageSourceConverter}}"
                                Stretch="UniformToFill" />
                            </Ellipse.Fill>
                          </Ellipse>
                          <TextBlock
                            FontSize="10"
                            Opacity="0.8"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"
                            Text="{Binding SubmittedBy, StringFormat='von {0}'}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>

          </ListView>
        </Grid>
      </Border>

      <!-- Collapsible Group Favorites Queue (auto-hidden when 0 liked tracks exist) -->
      <Border
        Grid.Row="2"
        Margin="0,6,0,0"
        Padding="8,6"
        CornerRadius="8"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        Visibility="{Binding HasFavoriteTracks, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <Grid Margin="2,0,2,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon
                Symbol="ThumbLike24"
                FontSize="13"
                Margin="0,0,6,0"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Gruppen-Favoriten" />
            </StackPanel>
            <ui:Button
              Grid.Column="1"
              Appearance="Transparent"
              Padding="4,1"
              Command="{Binding ToggleFavoritesExpandedCommand}">
              <ui:SymbolIcon FontSize="12">
                <ui:SymbolIcon.Style>
                  <Style TargetType="ui:SymbolIcon">
                    <Setter Property="Symbol" Value="ChevronUp24" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsFavoritesExpanded}" Value="False">
                        <Setter Property="Symbol" Value="ChevronDown24" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:SymbolIcon.Style>
              </ui:SymbolIcon>
            </ui:Button>
          </Grid>

          <ItemsControl
            ItemsSource="{Binding FavoriteTracks}"
            Visibility="{Binding IsFavoritesExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="2,2" LastChildFill="True">
                  <ui:Button
                    DockPanel.Dock="Right"
                    Appearance="Transparent"
                    Padding="6,2"
                    Margin="6,0,0,0"
                    ToolTip="Favorit in die aktuelle Warteschlange einreihen"
                    Command="{Binding DataContext.EnqueueFavoriteTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                    <ui:SymbolIcon Symbol="Add24" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  </ui:Button>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border
                      Padding="5,1"
                      Margin="0,0,6,0"
                      CornerRadius="4"
                      Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                      <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Text="{Binding Likes, StringFormat='+{0}'}" />
                    </Border>
                    <TextBlock
                      FontSize="11"
                      VerticalAlignment="Center"
                      TextTrimming="CharacterEllipsis"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      Text="{Binding Title}" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Mobile Web Drop Indicator with Copy & Browser Test Buttons -->
    <Border
      Grid.Row="6"
      Margin="0,0,0,6"
      Padding="10,4"
      CornerRadius="6"
      Background="{DynamicResource ControlFillColorSecondaryBrush}"
      Visibility="{Binding IsWebDropActive, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon
            Symbol="PhoneLaptop24"
            FontSize="15"
            Margin="0,0,6,0"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
          <TextBlock
            FontSize="11"
            VerticalAlignment="Center"
            Opacity="0.75"
            Text="Mobil / Web-Drop: " />
          <TextBlock
            FontSize="11"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
            Text="{Binding WebDropUrl}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ui:Button
            Appearance="Transparent"
            Padding="6,3"
            Margin="0,0,4,0"
            ToolTip="Web-Drop URL in die Zwischenablage kopieren"
            Icon="{ui:SymbolIcon Copy24}"
            Command="{Binding CopyWebDropUrlCommand}" />
          <ui:Button
            Appearance="Secondary"
            Padding="8,3"
            Margin="0,0,4,0"
            ToolTip="QR-Code zum Scannen auf dem Smartphone anzeigen"
            Icon="{ui:SymbolIcon QrCode24}"
            Content="QR-Code"
            Command="{Binding ToggleQrCodeCommand}" />
          <ui:Button
            Appearance="Secondary"
            Padding="8,3"
            ToolTip="Web-Drop direkt im Standardbrowser öffnen und testen"
            Icon="{ui:SymbolIcon Open24}"
            Content="Im Browser testen"
            Command="{Binding OpenWebDropInBrowserCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- In-App QR-Code Flyout Overlay -->
    <Border
      Grid.Row="1"
      Grid.RowSpan="7"
      Margin="16"
      Padding="16"
      CornerRadius="10"
      Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
      BorderThickness="1"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Visibility="{Binding IsQrCodeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel HorizontalAlignment="Center">
        <Grid Margin="0,0,0,10">
          <TextBlock
            Text="Web-Drop QR-Code"
            FontWeight="SemiBold"
            FontSize="14"
            HorizontalAlignment="Left"
            VerticalAlignment="Center" />
          <ui:Button
            Appearance="Transparent"
            Padding="4"
            HorizontalAlignment="Right"
            Icon="{ui:SymbolIcon Dismiss24}"
            Command="{Binding CloseQrCodeCommand}" />
        </Grid>

        <Border
          Background="White"
          Padding="8"
          CornerRadius="6"
          HorizontalAlignment="Center">
          <Image
            Source="{Binding QrCodeImage}"
            Width="200"
            Height="200"
            RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <TextBlock
          Margin="0,10,0,4"
          Text="{Binding WebDropUrl}"
          FontWeight="Medium"
          FontSize="12"
          HorizontalAlignment="Center"
          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

        <TextBlock
          Text="Mit der Smartphone-Kamera scannen, um Songs einzuwerfen"
          FontSize="11"
          Opacity="0.7"
          HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- VoIP Call Ducking Notification Banner (Active Call) -->
    <Border
      Grid.Row="7"
      Margin="0,0,0,6"
      Padding="8,5"
      CornerRadius="6"
      Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
      Visibility="{Binding IsCallActive, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <ui:SymbolIcon
          Symbol="Call24"
          FontSize="15"
          Margin="0,0,8,0"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock
          VerticalAlignment="Center"
          FontSize="12"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
          Text="{Binding TelephonyStatusText}" />
      </StackPanel>
    </Border>

    <!-- Bottom Status Bar (Telephony Provider & LAN Broadcast) -->
    <Grid Grid.Row="8" Margin="0,2,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock
          FontSize="10"
          Opacity="0.5"
          Text="Telefonie: " />
        <TextBlock
          FontSize="10"
          Opacity="0.7"
          FontWeight="Medium"
          Text="{Binding TelephonyProviderName, StringFormat='{}{0} – '}" />
        <TextBlock
          FontSize="10"
          Opacity="0.7"
          Text="{Binding TelephonyStateSummary}" />
      </StackPanel>

      <TextBlock
        Grid.Column="1"
        VerticalAlignment="Center"
        FontSize="10"
        Opacity="0.5"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding NetworkStatusText}" />
    </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
