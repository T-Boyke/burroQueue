<ui:FluentWindow
  x:Class="burroQueue.Presentation.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="burroQueue"
  Icon="pack://application:,,,/burroQueue;component/Assets/logo.png"
  Width="480"
  Height="560"
  AllowDrop="True"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
  DragOver="OnDragOver"
  Drop="OnDrop">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Native Title Bar with Burro Icon -->
    <ui:TitleBar Title="burroQueue" Grid.Row="0">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/burroQueue;component/Assets/logo.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Group Header & Rename Action -->
    <Grid Grid.Row="1" Margin="0,8,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:SymbolIcon
          Symbol="PeopleCommunity24"
          Margin="0,0,8,0"
          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <TextBlock
          FontSize="14"
          FontWeight="Normal"
          Opacity="0.75"
          Text="Gruppe: " />
        <TextBlock
          FontSize="14"
          FontWeight="SemiBold"
          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
          Text="{Binding GroupName}" />
      </StackPanel>

      <ui:Button
        Grid.Column="1"
        Appearance="Secondary"
        Padding="10,5"
        Icon="{ui:SymbolIcon Open24}"
        Content="Playlist öffnen"
        Visibility="{Binding CollaborativePlaylistUrl, Converter={StaticResource NullToVisibilityConverter}}"
        Command="{Binding OpenCollaborativePlaylistCommand}" />
    </Grid>

    <!-- Now Playing Card with Album Art & Skip Vote -->
    <Border
      Grid.Row="2"
      Margin="0,0,0,8"
      Padding="12"
      CornerRadius="8"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border
          Grid.Column="0"
          Width="64"
          Height="48"
          Margin="0,0,12,0"
          CornerRadius="4"
          ClipToBounds="True"
          Background="{DynamicResource SubtleFillColorSecondaryBrush}">
          <Image
            Source="{Binding CurrentTrackThumbnailUrl}"
            Stretch="UniformToFill" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock
            FontSize="13"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{Binding CurrentTrackTitle}" />
          <TextBlock
            Margin="0,2,0,0"
            FontSize="12"
            Opacity="0.65"
            TextTrimming="CharacterEllipsis"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding CurrentTrackArtist}" />
        </StackPanel>

        <!-- Vote to Skip Action -->
        <ui:Button
          Grid.Column="2"
          Appearance="Transparent"
          VerticalAlignment="Center"
          Padding="8,6"
          Icon="{ui:SymbolIcon Vote24}"
          Command="{Binding VoteToSkipCommand}">
          <TextBlock
            FontSize="12"
            FontWeight="Medium"
            Text="{Binding SkipVoteStatus, StringFormat='Skip ({0})'}" />
        </ui:Button>
      </Grid>
    </Border>

    <!-- Middle Section: Drop Zone & Interactive Queue View -->
    <Grid Grid.Row="3" Margin="0,0,0,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Primary Drop Zone -->
      <Border
        Grid.Row="0"
        Margin="0,0,0,8"
        Padding="14"
        CornerRadius="8"
        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <ui:SymbolIcon
            Symbol="ArrowDownload24"
            FontSize="26"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
          <TextBlock
            Margin="0,6,0,0"
            HorizontalAlignment="Center"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="YouTube-Link hier hineinziehen" />
          <TextBlock
            Margin="0,2,0,0"
            HorizontalAlignment="Center"
            FontSize="11"
            Opacity="0.65"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding StatusMessage}" />
        </StackPanel>
      </Border>

      <!-- Expandable Interactive Queue View -->
      <Border
        Grid.Row="1"
        CornerRadius="8"
        Padding="8"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Queue Header with Toggle -->
          <Grid Grid.Row="0" Margin="4,2,4,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="MusicNote24" Margin="0,0,6,0" FontSize="14" />
              <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="{Binding QueuedCount, StringFormat='Warteschlange ({0})'}" />
            </StackPanel>

            <ui:Button
              Grid.Column="1"
              Appearance="Transparent"
              Padding="6,2"
              Command="{Binding ToggleQueueExpandedCommand}">
              <ui:SymbolIcon Symbol="ChevronDown24" />
            </ui:Button>
          </Grid>

          <!-- Queued Items List -->
          <ListView
            Grid.Row="1"
            Visibility="{Binding IsQueueExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
            ItemsSource="{Binding QueuedItems}"
            Background="Transparent"
            BorderThickness="0"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                      FontSize="12"
                      FontWeight="Medium"
                      TextTrimming="CharacterEllipsis"
                      Text="{Binding Title}" />
                    <TextBlock
                      FontSize="10"
                      Opacity="0.6"
                      Text="{Binding SubmittedBy, StringFormat='von {0}'}" />
                  </StackPanel>

                  <ui:Button
                    Grid.Column="2"
                    Appearance="Transparent"
                    Padding="4"
                    Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                    CommandParameter="{Binding}">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="12" />
                  </ui:Button>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </Grid>

    <!-- Mobile Web Drop Indicator with Copy Button -->
    <Border
      Grid.Row="4"
      Margin="0,0,0,8"
      Padding="8,3"
      CornerRadius="6"
      Background="{DynamicResource ControlFillColorSecondaryBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon
            Symbol="PhoneLaptop24"
            FontSize="15"
            Margin="0,0,6,0"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
          <TextBlock
            FontSize="11"
            VerticalAlignment="Center"
            Opacity="0.75"
            Text="Mobil / Web-Drop aktiv: " />
          <TextBlock
            FontSize="11"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
            Text="{Binding WebDropUrl}" />
        </StackPanel>
        <ui:Button
          Grid.Column="1"
          Appearance="Transparent"
          Padding="6,3"
          ToolTip="Web-Drop URL in Zwischenablage kopieren"
          Icon="{ui:SymbolIcon Copy24}"
          Command="{Binding CopyWebDropUrlCommand}" />
      </Grid>
    </Border>

    <!-- VoIP Call Ducking Notification Banner -->
    <Border
      Grid.Row="5"
      Margin="0,0,0,8"
      Padding="8,5"
      CornerRadius="6"
      Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
      Visibility="{Binding IsCallActive, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <ui:SymbolIcon
          Symbol="Call24"
          FontSize="15"
          Margin="0,0,8,0"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock
          VerticalAlignment="Center"
          FontSize="12"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
          Text="{Binding TelephonyStatusText}" />
      </StackPanel>
    </Border>

    <!-- Playback Navigation Bar -->
    <Grid Grid.Row="6" Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal">
        <ui:Button
          Margin="0,0,6,0"
          Appearance="Secondary"
          Icon="{ui:SymbolIcon Play24}"
          Content="Play"
          Command="{Binding PlayCommand}" />
        <ui:Button
          Margin="0,0,6,0"
          Appearance="Secondary"
          Icon="{ui:SymbolIcon Pause24}"
          Content="Pause"
          Command="{Binding PauseCommand}" />
        <ui:Button
          Margin="0,0,6,0"
          Appearance="Secondary"
          Icon="{ui:SymbolIcon Stop24}"
          Content="Stop"
          Command="{Binding StopCommand}" />
        <ui:Button
          Margin="0,0,6,0"
          Appearance="Secondary"
          Icon="{ui:SymbolIcon Next24}"
          Content="Skip"
          Command="{Binding SkipCommand}" />
      </StackPanel>

      <TextBlock
        Grid.Column="1"
        VerticalAlignment="Center"
        FontSize="12"
        Opacity="0.65"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding QueuedCount, StringFormat='Queue: {0}'}" />
    </Grid>
  </Grid>
</ui:FluentWindow>
