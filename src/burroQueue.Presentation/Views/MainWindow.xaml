<ui:FluentWindow
  x:Class="burroQueue.Presentation.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="burroQueue"
  Icon="pack://application:,,,/burroQueue;component/Assets/logo.png"
  Width="520"
  Height="680"
  AllowDrop="True"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  ShowInTaskbar="True"
  FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
  DragOver="OnDragOver"
  Drop="OnDrop">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Native Title Bar with Burro Icon -->
    <ui:TitleBar Title="burroQueue" Grid.Row="0">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/burroQueue;component/Assets/logo.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Group Header, Quick Settings & Collaborative Playlist -->
    <StackPanel Grid.Row="1" Margin="0,6,0,8">
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon
            Symbol="PeopleCommunity24"
            Margin="0,0,8,0"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
          <TextBlock
            FontSize="13"
            FontWeight="Normal"
            Opacity="0.75"
            Text="Gruppe: " />
          <TextBlock
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
            Text="{Binding GroupName}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button
            Appearance="Secondary"
            Padding="8,4"
            Margin="0,0,6,0"
            Icon="{ui:SymbolIcon Open24}"
            Content="Playlist öffnen"
            Visibility="{Binding CollaborativePlaylistUrl, Converter={StaticResource NullToVisibilityConverter}}"
            Command="{Binding OpenCollaborativePlaylistCommand}" />
          <ui:Button
            Appearance="Secondary"
            Padding="8,4"
            Icon="{ui:SymbolIcon Settings24}"
            Content="Einstellungen"
            Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
      </Grid>

      <!-- First-Join Collaborative YouTube Playlist Prompt Banner -->
      <Border
        Margin="0,4,0,0"
        Padding="10,8"
        CornerRadius="6"
        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        Visibility="{Binding IsFirstJoinPromptVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock
              FontWeight="SemiBold"
              FontSize="11"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="Gemeinsame YouTube-Playlist verfügbar!" />
            <TextBlock
              Margin="0,1,0,0"
              FontSize="10"
              Opacity="0.8"
              TextWrapping="Wrap"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="Tritt der YouTube-Playlist bei, um Songs mit der Gruppe zu synchronisieren." />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
            <ui:Button
              Appearance="Primary"
              Padding="8,3"
              Margin="0,0,4,0"
              FontSize="11"
              Content="Auf YouTube beitreten"
              Command="{Binding OpenYouTubeInviteAndDismissPromptCommand}" />
            <ui:Button
              Appearance="Transparent"
              Padding="4,2"
              ToolTip="Ausblenden"
              Command="{Binding DismissFirstJoinPromptCommand}">
              <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
            </ui:Button>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- Now Playing Card with Album Art & Skip Vote -->
    <Border
      Grid.Row="2"
      Margin="0,0,0,8"
      Padding="12"
      CornerRadius="8"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border
            Grid.Column="0"
            Width="64"
            Height="48"
            Margin="0,0,12,0"
            CornerRadius="4"
            ClipToBounds="True"
            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Image
              Source="{Binding CurrentTrackThumbnailUrl}"
              Stretch="UniformToFill" />
          </Border>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              TextTrimming="CharacterEllipsis"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="{Binding CurrentTrackTitle}" />
            <TextBlock
              Margin="0,2,0,0"
              FontSize="12"
              Opacity="0.65"
              TextTrimming="CharacterEllipsis"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{Binding CurrentTrackArtist}" />
          </StackPanel>

          <!-- Vote to Skip Action -->
          <ui:Button
            Grid.Column="2"
            Appearance="Transparent"
            VerticalAlignment="Center"
            Padding="8,6"
            Icon="{ui:SymbolIcon Vote24}"
            Command="{Binding VoteToSkipCommand}">
            <TextBlock
              FontSize="12"
              FontWeight="Medium"
              Text="{Binding SkipVoteStatus, StringFormat='Skip ({0})'}" />
          </ui:Button>
        </Grid>

        <!-- Visual Playback Progress Indicator (Non-interactive) -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ProgressBar
            Grid.Row="0"
            Height="3"
            Minimum="0"
            Maximum="100"
            Value="{Binding PlaybackProgress}"
            IsIndeterminate="False"
            Foreground="{DynamicResource AccentFillColorDefaultBrush}"
            Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
          <TextBlock
            Grid.Row="1"
            Margin="0,4,0,0"
            FontSize="10"
            Opacity="0.6"
            HorizontalAlignment="Right"
            Text="{Binding PlaybackTimeFormatted}" />
        </Grid>
      </Grid>
    </Border>

    <!-- Playback Navigation Bar -->
    <Grid Grid.Row="3" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal">
        <ui:Button
          Margin="0,0,6,0"
          Appearance="Secondary"
          Icon="{ui:SymbolIcon Play24}"
          Content="Play"
          Command="{Binding PlayCommand}" />
        <ui:Button
          Margin="0,0,6,0"
          Appearance="Secondary"
          Icon="{ui:SymbolIcon Pause24}"
          Content="Pause"
          Command="{Binding PauseCommand}" />
        <ui:Button
          Margin="0,0,6,0"
          Appearance="Secondary"
          Icon="{ui:SymbolIcon Stop24}"
          Content="Stop"
          Command="{Binding StopCommand}" />
        <ui:Button
          Margin="0,0,6,0"
          Appearance="Secondary"
          Icon="{ui:SymbolIcon Next24}"
          Content="Skip"
          Command="{Binding SkipCommand}" />
      </StackPanel>

      <Border
        Grid.Column="1"
        VerticalAlignment="Center"
        Padding="8,3"
        CornerRadius="4"
        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
        <TextBlock
          FontSize="11"
          FontWeight="Medium"
          Opacity="0.8"
          Text="{Binding PlaybackState, StringFormat='Status: {0}'}" />
      </Border>
    </Grid>

    <!-- Master Volume, Ducking Badge & Audio Routing Bar -->
    <Border
      Grid.Row="4"
      Margin="0,0,0,8"
      Padding="10,6"
      CornerRadius="8"
      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Mute / Speaker Toggle Button -->
        <ui:Button
          Grid.Column="0"
          Appearance="Transparent"
          Padding="4,2"
          Margin="0,0,8,0"
          ToolTip="Stummschalten / Lautstärke wiederherstellen"
          Command="{Binding ToggleMuteCommand}">
          <ui:SymbolIcon Symbol="Speaker224" FontSize="16" />
        </ui:Button>

        <!-- Master Volume Slider -->
        <Slider
          Grid.Column="1"
          VerticalAlignment="Center"
          Minimum="0.0"
          Maximum="1.0"
          SmallChange="0.05"
          LargeChange="0.1"
          Value="{Binding MasterVolume, Mode=TwoWay}" />

        <!-- Volume Percentage -->
        <TextBlock
          Grid.Column="2"
          Margin="8,0,10,0"
          VerticalAlignment="Center"
          FontSize="12"
          FontWeight="SemiBold"
          Width="40"
          TextAlignment="Right"
          Text="{Binding MasterVolume, StringFormat='{}{0:P0}'}" />

        <!-- Audio Device & Ducking Status Pill -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Border
            Margin="0,0,6,0"
            Padding="6,2"
            CornerRadius="4"
            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
            Visibility="{Binding IsAudioDucked, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock
              FontSize="10"
              FontWeight="Bold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="Ducking aktiv" />
          </Border>

          <TextBlock
            FontSize="11"
            VerticalAlignment="Center"
            Opacity="0.7"
            ToolTip="Aktives Audio-Ausgabegerät (in Einstellungen anpassen)"
            Text="{Binding ActiveAudioDeviceName}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Middle Section: Drop Zone & Interactive Queue View -->
    <Grid Grid.Row="5" Margin="0,0,0,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Primary Drop Zone & Quick Add Bar -->
      <Border
        Grid.Row="0"
        Margin="0,0,0,8"
        Padding="12,10"
        CornerRadius="8"
        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1">
        <StackPanel>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:SymbolIcon
              Symbol="ArrowDownload24"
              FontSize="22"
              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock
              Margin="0,3,0,0"
              HorizontalAlignment="Center"
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
              Text="YouTube-Link hier hineinziehen oder per Ctrl+V einfügen" />
            <TextBlock
              Margin="0,1,0,0"
              HorizontalAlignment="Center"
              FontSize="11"
              Opacity="0.65"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="{Binding StatusMessage}" />
          </StackPanel>

          <!-- Visual Add Feedback Banner -->
          <Border
            Margin="0,8,0,0"
            Padding="8,5"
            CornerRadius="6"
            Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Visibility="{Binding IsAddFeedbackVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
              <TextBlock
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding LastAddedFeedbackText}" />
            </StackPanel>
          </Border>

          <!-- Quick-Add Input Bar with Enter support -->
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
              Grid.Column="0"
              Margin="0,0,6,0"
              Padding="8,5"
              PlaceholderText="YouTube-Link oder Video-ID hier eintippen..."
              Text="{Binding QuickAddUrl, UpdateSourceTrigger=PropertyChanged}"
              KeyDown="OnQuickAddKeyDown" />
            <ui:Button
              Grid.Column="1"
              Appearance="Primary"
              Padding="10,5"
              ToolTip="Titel zur Warteschlange hinzufügen"
              Command="{Binding SubmitQuickAddCommand}">
              <ui:SymbolIcon Symbol="Add24" FontSize="14" />
            </ui:Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Expandable Interactive Queue View -->
      <Border
        Grid.Row="1"
        CornerRadius="8"
        Padding="8"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Queue Header with Toggle & Clear Action -->
          <Grid Grid.Row="0" Margin="4,2,4,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:SymbolIcon Symbol="MusicNote224" Margin="0,0,6,0" FontSize="14" />
              <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="{Binding QueuedCount, StringFormat='Warteschlange ({0})'}" />
            </StackPanel>

            <ui:Button
              Grid.Column="1"
              Appearance="Transparent"
              Padding="6,2"
              Margin="0,0,4,0"
              ToolTip="Warteschlange leeren"
              Command="{Binding ClearQueueCommand}">
              <ui:SymbolIcon Symbol="Delete24" FontSize="13" />
            </ui:Button>

            <ui:Button
              Grid.Column="2"
              Appearance="Transparent"
              Padding="6,2"
              Command="{Binding ToggleQueueExpandedCommand}">
              <ui:SymbolIcon Symbol="ChevronDown24" />
            </ui:Button>
          </Grid>

          <!-- Queued Items List -->
          <ListView
            Grid.Row="1"
            Visibility="{Binding IsQueueExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
            ItemsSource="{Binding QueuedItems}"
            Background="Transparent"
            BorderThickness="0"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3,0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                      Grid.Column="0"
                      Width="44"
                      Height="33"
                      CornerRadius="4"
                      Margin="0,0,10,0"
                      ClipToBounds="True"
                      Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                      <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock
                        FontSize="12"
                        FontWeight="Medium"
                        TextTrimming="CharacterEllipsis"
                        Text="{Binding Title}" />
                      <TextBlock
                        FontSize="10"
                        Opacity="0.6"
                        Text="{Binding SubmittedBy, StringFormat='von {0}'}" />
                    </StackPanel>
                  </Grid>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button
                      Appearance="Transparent"
                      Padding="3"
                      Margin="0,0,2,0"
                      ToolTip="Nach oben verschieben"
                      Command="{Binding DataContext.MoveTrackUpCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                      CommandParameter="{Binding}">
                      <ui:SymbolIcon Symbol="ArrowUp24" FontSize="11" />
                    </ui:Button>
                    <ui:Button
                      Appearance="Transparent"
                      Padding="3"
                      Margin="0,0,4,0"
                      ToolTip="Nach unten verschieben"
                      Command="{Binding DataContext.MoveTrackDownCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                      CommandParameter="{Binding}">
                      <ui:SymbolIcon Symbol="ArrowDown24" FontSize="11" />
                    </ui:Button>
                    <ui:Button
                      Appearance="Transparent"
                      Padding="4"
                      ToolTip="Aus Warteschlange entfernen"
                      Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                      CommandParameter="{Binding}">
                      <ui:SymbolIcon Symbol="Delete24" FontSize="12" />
                    </ui:Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>

          </ListView>
        </Grid>
      </Border>
    </Grid>

    <!-- Mobile Web Drop Indicator with Copy & Browser Test Buttons -->
    <Border
      Grid.Row="6"
      Margin="0,0,0,6"
      Padding="10,4"
      CornerRadius="6"
      Background="{DynamicResource ControlFillColorSecondaryBrush}"
      Visibility="{Binding IsWebDropActive, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon
            Symbol="PhoneLaptop24"
            FontSize="15"
            Margin="0,0,6,0"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
          <TextBlock
            FontSize="11"
            VerticalAlignment="Center"
            Opacity="0.75"
            Text="Mobil / Web-Drop: " />
          <TextBlock
            FontSize="11"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
            Text="{Binding WebDropUrl}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ui:Button
            Appearance="Transparent"
            Padding="6,3"
            Margin="0,0,4,0"
            ToolTip="Web-Drop URL in die Zwischenablage kopieren"
            Icon="{ui:SymbolIcon Copy24}"
            Command="{Binding CopyWebDropUrlCommand}" />
          <ui:Button
            Appearance="Secondary"
            Padding="8,3"
            Margin="0,0,4,0"
            ToolTip="QR-Code zum Scannen auf dem Smartphone anzeigen"
            Icon="{ui:SymbolIcon QrCode24}"
            Content="QR-Code"
            Command="{Binding ToggleQrCodeCommand}" />
          <ui:Button
            Appearance="Secondary"
            Padding="8,3"
            ToolTip="Web-Drop direkt im Standardbrowser öffnen und testen"
            Icon="{ui:SymbolIcon Open24}"
            Content="Im Browser testen"
            Command="{Binding OpenWebDropInBrowserCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- In-App QR-Code Flyout Overlay -->
    <Border
      Grid.Row="1"
      Grid.RowSpan="7"
      Margin="16"
      Padding="16"
      CornerRadius="10"
      Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
      BorderThickness="1"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Visibility="{Binding IsQrCodeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel HorizontalAlignment="Center">
        <Grid Margin="0,0,0,10">
          <TextBlock
            Text="Web-Drop QR-Code"
            FontWeight="SemiBold"
            FontSize="14"
            HorizontalAlignment="Left"
            VerticalAlignment="Center" />
          <ui:Button
            Appearance="Transparent"
            Padding="4"
            HorizontalAlignment="Right"
            Icon="{ui:SymbolIcon Dismiss24}"
            Command="{Binding CloseQrCodeCommand}" />
        </Grid>

        <Border
          Background="White"
          Padding="8"
          CornerRadius="6"
          HorizontalAlignment="Center">
          <Image
            Source="{Binding QrCodeImage}"
            Width="200"
            Height="200"
            RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <TextBlock
          Margin="0,10,0,4"
          Text="{Binding WebDropUrl}"
          FontWeight="Medium"
          FontSize="12"
          HorizontalAlignment="Center"
          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

        <TextBlock
          Text="Mit der Smartphone-Kamera scannen, um Songs einzuwerfen"
          FontSize="11"
          Opacity="0.7"
          HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- VoIP Call Ducking Notification Banner (Active Call) -->
    <Border
      Grid.Row="7"
      Margin="0,0,0,6"
      Padding="8,5"
      CornerRadius="6"
      Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
      Visibility="{Binding IsCallActive, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <ui:SymbolIcon
          Symbol="Call24"
          FontSize="15"
          Margin="0,0,8,0"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock
          VerticalAlignment="Center"
          FontSize="12"
          FontWeight="SemiBold"
          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
          Text="{Binding TelephonyStatusText}" />
      </StackPanel>
    </Border>

    <!-- Bottom Status Bar (Telephony Provider & LAN Broadcast) -->
    <Grid Grid.Row="8" Margin="0,2,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock
          FontSize="10"
          Opacity="0.5"
          Text="Telefonie: " />
        <TextBlock
          FontSize="10"
          Opacity="0.7"
          FontWeight="Medium"
          Text="{Binding TelephonyProviderName, StringFormat='{}{0} – '}" />
        <TextBlock
          FontSize="10"
          Opacity="0.7"
          Text="{Binding TelephonyStateSummary}" />
      </StackPanel>

      <TextBlock
        Grid.Column="1"
        VerticalAlignment="Center"
        FontSize="10"
        Opacity="0.5"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding NetworkStatusText}" />
    </Grid>
  </Grid>
</ui:FluentWindow>
