<ui:FluentWindow
  x:Class="burroQueue.Presentation.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="burroQueue"
  Icon="/Assets/logo.png"
  Width="440"
  Height="460"
  AllowDrop="True"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  DragOver="OnDragOver"
  Drop="OnDrop">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title Bar -->
    <ui:TitleBar Title="🫏 burroQueue" Grid.Row="0" />

    <!-- Group Header & Rename -->
    <Grid Grid.Row="1" Margin="0,8,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock
          FontSize="15"
          FontWeight="Bold"
          Text="Gruppe: " />
        <TextBlock
          FontSize="15"
          FontWeight="SemiBold"
          Foreground="#4FC3F7"
          Text="{Binding GroupName}" />
      </StackPanel>
      <Button
        Grid.Column="1"
        Padding="8,4"
        Content="Playlist öffnen"
        Visibility="{Binding CollaborativePlaylistUrl, Converter={x:Null}}"
        Command="{Binding OpenCollaborativePlaylistCommand}" />
    </Grid>

    <!-- Now Playing Card with Thumbnail -->
    <Border
      Grid.Row="2"
      Margin="0,0,0,8"
      Padding="12"
      CornerRadius="8"
      Background="#22FFFFFF">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Image
          Grid.Column="0"
          Width="64"
          Height="48"
          Margin="0,0,12,0"
          Source="{Binding CurrentTrackThumbnailUrl}"
          Stretch="UniformToFill" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock
            FontSize="14"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis"
            Text="{Binding CurrentTrackTitle}" />
          <TextBlock
            Margin="0,2,0,0"
            FontSize="12"
            Opacity="0.7"
            TextTrimming="CharacterEllipsis"
            Text="{Binding CurrentTrackArtist}" />
        </StackPanel>

        <!-- Vote To Skip Button -->
        <Button
          Grid.Column="2"
          VerticalAlignment="Center"
          Padding="8,6"
          Command="{Binding VoteToSkipCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="🗳️ Skip (" />
            <TextBlock Text="{Binding SkipVoteStatus}" />
            <TextBlock Text=")" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Drop Zone -->
    <Border
      Grid.Row="3"
      Margin="0,0,0,8"
      Padding="12"
      CornerRadius="8"
      Background="#15FFFFFF">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock
          HorizontalAlignment="Center"
          FontSize="15"
          FontWeight="SemiBold"
          Text="Drop YouTube Link Here" />
        <TextBlock
          Margin="0,4,0,0"
          HorizontalAlignment="Center"
          FontSize="12"
          Opacity="0.8"
          Text="{Binding StatusMessage}" />
      </StackPanel>
    </Border>

    <!-- Mobile Web Drop Banner -->
    <Border
      Grid.Row="4"
      Margin="0,0,0,8"
      Padding="8"
      CornerRadius="6"
      Background="#1A4FC3F7">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock Text="📱 Handy Web-Drop aktiv: " FontSize="12" Opacity="0.8" />
        <TextBlock Text="{Binding WebDropUrl}" FontSize="12" FontWeight="SemiBold" Foreground="#4FC3F7" />
      </StackPanel>
    </Border>

    <!-- Telephony / Call Ducking Banner -->
    <Border
      Grid.Row="5"
      Margin="0,0,0,8"
      Padding="8"
      CornerRadius="6"
      Background="#FFE57F"
      Visibility="{Binding IsCallActive, Converter={x:Null}}">
      <TextBlock
        HorizontalAlignment="Center"
        Foreground="#212121"
        FontWeight="Medium"
        Text="{Binding TelephonyStatusText}" />
    </Border>

    <!-- Playback Control Bar -->
    <Grid Grid.Row="6" Margin="0,4,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal">
        <Button
          Margin="0,0,6,0"
          Content="▶ Play"
          Command="{Binding PlayCommand}" />
        <Button
          Margin="0,0,6,0"
          Content="⏸ Pause"
          Command="{Binding PauseCommand}" />
        <Button
          Margin="0,0,6,0"
          Content="⏹ Stop"
          Command="{Binding StopCommand}" />
        <Button
          Margin="0,0,6,0"
          Content="⏭ Skip"
          Command="{Binding SkipCommand}" />
      </StackPanel>

      <TextBlock
        Grid.Column="1"
        VerticalAlignment="Center"
        Opacity="0.75"
        Text="{Binding QueuedCount, StringFormat='Queue: {0}'}" />
    </Grid>
  </Grid>
</ui:FluentWindow>
